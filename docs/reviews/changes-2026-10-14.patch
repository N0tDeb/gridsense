+        delivered = {p.relative_to(tmp_path).as_posix() for p in selected_files(tmp_path)}
+        assert delivered == {"backend/example.py", "pyproject.toml", "requirements-dev.lock"}
+        assert verification_inputs(tmp_path) == fingerprints
