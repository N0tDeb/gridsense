{
  "name": "gridsense-dashboard",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --config prettier.config.mjs --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" index.html prettier.config.mjs \"../scripts/*.mjs\"",
    "format:check": "prettier --config prettier.config.mjs --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.ts\" \"*.json\" index.html prettier.config.mjs \"../scripts/*.mjs\"",
    "check:runtime": "node ../scripts/check_runtime.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@xyflow/react": "12.11.6",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.5.3",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
